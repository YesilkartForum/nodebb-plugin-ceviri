{
  "name": "nodebb-plugin-ceviri",
  "version": "4.14.0",
  "description": "A translation plugin for YesilkartForum",
  "main": "library.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/YesilkartForum/nodebb-plugin-ceviri"
  },
  "scripts": {
    "lint": "eslint ."
  },
  "keywords": [
    "nodebb",
    "plugin",
    "quickstart",
    "shell"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/YesilkartForum/nodebb-plugin-ceviri/issues"
  },
  "readmeFilename": "README.md",
  "nbbpm": {
    "compatibility": "^4.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-angular": "21.2.0",
    "eslint": "10.7.0",
    "eslint-config-nodebb": "2.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.0.8"
  }
}
